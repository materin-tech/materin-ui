{
  "name": "@materin-tech/materin-ui",
  "version": "0.2.0",
  "description": "Materin UI · Vue 3 组件库 — 与组织站点和 Obsidian 插件共用一套令牌与命名契约",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/materin-ui/index.d.ts",
  "files": [
    "dist",
    "packages/styles/tokens.scss",
    "tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/materin-ui/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css",
    "./tokens": "./tokens/materin-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "vite",
    "docs:build": "vite build",
    "docs:preview": "vite preview --outDir docs-dist",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "build": "npm run build:lib && npm run build:types",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "rollup": "^4.9.0",
    "sass": "^1.70.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.12"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "obsidian",
    "materin-tech",
    "materin-ui"
  ],
  "license": "MIT",
  "author": "leapord",
  "homepage": "https://materin-tech.github.io/materin-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/materin-tech/materin-ui.git"
  },
  "bugs": {
    "url": "https://github.com/materin-tech/materin-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
